rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // User Rules
    match /users/{userId} {
      function isValidUser(data) {
        return data.uid == userId &&
               data.email is string &&
               data.displayName is string &&
               data.keys().hasAll(['uid', 'email', 'displayName']);
      }

      allow get: if isSignedIn();
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming()) && 
                    incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'role', 'updatedAt']);

      match /following/{followId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Tournament Rules
    function isTournamentEditor(tId) {
      return isSignedIn() && (
        (exists(/databases/$(database)/documents/tournaments/$(tId)) && (
          get(/databases/$(database)/documents/tournaments/$(tId)).data.creatorId == request.auth.uid ||
          (
            "editors" in get(/databases/$(database)/documents/tournaments/$(tId)).data &&
            request.auth.uid in get(/databases/$(database)/documents/tournaments/$(tId)).data.editors
          )
        ))
      );
    }

    match /tournaments/{tournamentId} {
      function isTournamentCreator() {
        return isSignedIn() && (
          (exists(/databases/$(database)/documents/tournaments/$(tournamentId)) && 
           get(/databases/$(database)/documents/tournaments/$(tournamentId)).data.creatorId == request.auth.uid) ||
           (incoming().creatorId == request.auth.uid)
        );
      }

      function isValidTournament(data) {
        return data.name is string && data.name.size() <= 100 &&
               data.type in ['league', 'knockout', 'league_playoff'] &&
               data.status in ['upcoming', 'live', 'completed', 'finished'] &&
               data.creatorId == request.auth.uid;
      }

      allow read: if true;
      allow create: if isSignedIn() && isValidTournament(incoming());
      allow update: if isSignedIn() && (
        // Tournament Creator can update settings, status, editors list, etc.
        (existing().creatorId == request.auth.uid && incoming().creatorId == existing().creatorId) ||
        // User joining as an editor via editor invite token
        (
          "editorInviteToken" in existing() &&
          existing().editorInviteToken != null &&
          incoming().creatorId == existing().creatorId &&
          incoming().diff(existing()).affectedKeys().hasOnly(['editors', 'editorMembers']) &&
          request.auth.uid in incoming().editors
        )
      );
      allow delete: if isSignedIn() && existing().creatorId == request.auth.uid;
    }

    // Team Rules
    match /tournaments/{tournamentId}/teams/{teamId} {
      allow read: if true;
      allow create, update: if isTournamentEditor(tournamentId);
      allow delete: if isTournamentEditor(tournamentId) || (isSignedIn() && (!exists(/databases/$(database)/documents/tournaments/$(tournamentId)) || resource.data.creatorId == request.auth.uid));

      match /players/{playerId} {
        allow read: if true;
        allow create, update: if isTournamentEditor(tournamentId);
        allow delete: if isTournamentEditor(tournamentId) || (isSignedIn() && !exists(/databases/$(database)/documents/tournaments/$(tournamentId)));
      }
    }

    // Match Rules
    match /tournaments/{tournamentId}/matches/{matchId} {
      allow read: if true;
      allow create, update: if isTournamentEditor(tournamentId);
      allow delete: if isTournamentEditor(tournamentId);
    }

    // Event Rules
    match /tournaments/{tournamentId}/matches/{matchId}/events/{eventId} {
      allow read: if true;
      allow create, update, delete: if isTournamentEditor(tournamentId);
    }

    // Support collectionGroup queries for teams
    match /{path=**}/teams/{teamId} {
      allow read, list: if true;
    }

    // Support collectionGroup queries for events
    match /{path=**}/events/{eventId} {
      allow read, list: if true;
      allow delete: if isSignedIn() && (
        resource.data.tournamentId != null &&
        isTournamentEditor(resource.data.tournamentId)
      );
    }

    // Support collectionGroup queries for players
    match /{path=**}/players/{playerId} {
      allow read, list: if true;
    }

    // Recruitment Rules
    match /recruitment/{postId} {
      allow read, list: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Link Shortener Rules
    match /short_urls/{shortId} {
      allow read: if true;
      allow create: if true;
    }
  }
}
