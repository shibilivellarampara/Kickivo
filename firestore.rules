rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // User Rules
    match /users/{userId} {
      function isValidUser(data) {
        return data.uid == userId &&
               data.email is string &&
               data.displayName is string &&
               data.keys().hasAll(['uid', 'email', 'displayName']);
      }

      allow get: if isOwner(userId);
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming()) && 
                    incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'role', 'updatedAt']);

      match /following/{followId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Tournament Rules
    match /tournaments/{tournamentId} {
      function isTournamentCreator() {
        return isSignedIn() && (
          (exists(/databases/$(database)/documents/tournaments/$(tournamentId)) && 
           get(/databases/$(database)/documents/tournaments/$(tournamentId)).data.creatorId == request.auth.uid) ||
           (incoming().creatorId == request.auth.uid)
        );
      }

      function isValidTournament(data) {
        return data.name is string && data.name.size() <= 100 &&
               data.type in ['league', 'knockout', 'league_playoff'] &&
               data.status in ['upcoming', 'live', 'completed', 'finished'] &&
               data.creatorId == request.auth.uid;
      }

      allow read: if true;
      allow create: if isSignedIn() && isValidTournament(incoming());
      allow update: if isSignedIn() && 
                    existing().creatorId == request.auth.uid && 
                    (incoming().status in ['upcoming', 'live', 'completed', 'finished']) &&
                    incoming().creatorId == existing().creatorId;
      allow delete: if isSignedIn() && existing().creatorId == request.auth.uid;
    }

    // Team Rules
    match /tournaments/{tournamentId}/teams/{teamId} {
      allow read: if true;
      allow create, update: if isSignedIn() && 
                             get(/databases/$(database)/documents/tournaments/$(tournamentId)).data.creatorId == request.auth.uid;
      allow delete: if isSignedIn() && 
                       get(/databases/$(database)/documents/tournaments/$(tournamentId)).data.creatorId == request.auth.uid;

      match /players/{playerId} {
        function isTournamentCreator() {
          return isSignedIn() &&
                 get(/databases/$(database)/documents/tournaments/$(tournamentId)).data.creatorId == request.auth.uid;
        }

        // A player self-joining a team via the invite link creates their own
        // roster slot, or claims an existing unclaimed slot. Either way they
        // may only ever set userId to themselves, and a claim may not touch
        // name/stat fields that the creator manages.
        function isSelfJoinCreate() {
          return isSignedIn() &&
                 incoming().userId == request.auth.uid &&
                 incoming().teamId == teamId &&
                 incoming().tournamentId == tournamentId &&
                 incoming().keys().hasOnly(['name', 'userId', 'teamId', 'tournamentId', 'number', 'position', 'createdAt']);
        }

        function isSelfClaim() {
          return isSignedIn() &&
                 existing().userId == null &&
                 incoming().userId == request.auth.uid &&
                 incoming().diff(existing()).affectedKeys().hasOnly(['userId', 'tournamentId', 'updatedAt']);
        }

        allow read: if true;
        allow create: if isTournamentCreator() || isSelfJoinCreate();
        allow update: if isTournamentCreator() || isSelfClaim();
        allow delete: if isTournamentCreator();
      }
    }

    // Match Rules
    match /tournaments/{tournamentId}/matches/{matchId} {
      allow read: if true;
      allow create, update: if isSignedIn() && 
                      get(/databases/$(database)/documents/tournaments/$(tournamentId)).data.creatorId == request.auth.uid;
      allow delete: if isSignedIn() && 
                      get(/databases/$(database)/documents/tournaments/$(tournamentId)).data.creatorId == request.auth.uid;
    }

    // Event Rules
    match /tournaments/{tournamentId}/matches/{matchId}/events/{eventId} {
      allow read: if true;
      allow create: if isSignedIn() && 
                      get(/databases/$(database)/documents/tournaments/$(tournamentId)).data.creatorId == request.auth.uid;
    }

    // Support collectionGroup queries for teams
    match /{path=**}/teams/{teamId} {
      allow read, list: if true;
    }

    // Support collectionGroup queries for events
    match /{path=**}/events/{eventId} {
      allow read, list: if true;
      allow delete: if isSignedIn() && 
                      get(/databases/$(database)/documents/tournaments/$(resource.data.tournamentId)).data.creatorId == request.auth.uid;
    }

    // Support collectionGroup queries for players
    match /{path=**}/players/{playerId} {
      allow read, list: if true;
    }

    // Recruitment Rules
    match /recruitment/{postId} {
      allow read, list: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
